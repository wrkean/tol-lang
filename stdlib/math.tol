# Ang module na ito ay sinasadyang walang laman. Ang mga paraan na tinatawag na nagmula dito ay kilala ng compiler at hindi na dapat
# nilalagay pa dito.
#
# Ito ang mga paraan na nabibilang dito:
#   abs(numero_o_lutang)
#   sqrt(numero_o_lutang)
#
# Ang mga implementasyon ay ginawa sa linggwaheng Rust, makikita sa io.rs: ../src/builtins/native_functions/math.rs

# Archimedes' constant
ang PI = 3.14159265358979323846264338327950288

# Euler's number
ang E = 2.71828182845904523536028747135266250

# Euler-Mascheroni constant
ang EULER_GAMMA = 0.577215664901532860606512090082402431

# Golden ratio
ang PHI = 1.618033988749894848204586834365638118

# Full circle constant
ang TAU = 6.28318530717958647692528676655900577

paraan lerp(a, b, t):
    ibalik a + (b - a) * t
