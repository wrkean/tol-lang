# Ang module na ito ay sinasadyang walang laman. Ang mga paraan na tinatawag na nagmula dito ay kilala ng compiler at hindi na dapat
# nilalagay pa dito.
#
# Ito ang mga paraan na nabibilang dito:
#   abs(numero_o_lutang)
#   sqrt(numero_o_lutang)
#
# Ang mga implementasyon ay ginawa sa linggwaheng Rust, makikita sa io.rs: ../src/builtins/native_functions/math.rs
