io.isulatln("Kumusta mundo!")
io.isulatln("{}", math.PI)

ang lista = Lista.bago()
ang numero = 65.bilangKarakter()
io.isulatln("{}", numero)
ang teksto = Teksto.bilangNumero("5")
io.isulatln("{}", teksto)

bawat numero sa lista:
    io.isulatln("{}", numero)

bawat numero sa 0..=5:
    io.isulatln("{}", -numero)

kung di totoo:
    io.isulatln("unreachable")
kungwala:
    io.isulatln("reachable")
