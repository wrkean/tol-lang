klase BrainfuckInterpreter:
    paraan bago(code, in):
        ang interpreter = BrainfuckInterpreter()
        interpreter.dp = 0
        interpreter.pc = 0
        interpreter.input_pc = 0
        interpreter.tape = @[0; 30000]
        interpreter.code = code
        interpreter.input = in
        ibalik interpreter

    paraan takbo(ako):
        habang ako.pc < ako.code.haba():
            ang cmd = ako.code[ako.pc]
            ako.takbuhinCmd(cmd)
            ako.pc += 1

    paraan takbuhinCmd(ako, cmd):
        kung cmd == '>':
            ako.dp += 1
        kung cmd == '<':
            ako.dp -= 1
        kung cmd == '+':
            ako.tape[ako.dp] = (ako.tape[ako.dp] + 1) % 256
        kung cmd == '-':
            ako.tape[ako.dp] = (ako.tape[ako.dp] - 1) % 256
        kung cmd == '.':
            print("{}", ako.tape[ako.dp].bilangKarakter())
        kung cmd == ',':
            kung ako.input_pc < ako.input.haba():
                ako.tape[ako.dp] = ako.input[ako.input_pc].titik()
                ako.input_pc += 1
            kungwala:
                ako.tape[ako.dp] = 0
        kung cmd == '[':
            kung ako.tape[ako.dp] == 0:
                ang lalim = 1
                habang lalim > 0:
                    ako.pc += 1
                    kung ako.code[ako.pc] == '[':
                        lalim += 1
                    kundi ako.code[ako.pc] == ']':
                        lalim -= 1
        kung cmd == ']':
            kung ako.tape[ako.dp] != 0:
                ang lalim = 1
                habang lalim > 0:
                    ako.pc -= 1
                    kung ako.code[ako.pc] == '[':
                        lalim -= 1
                    kung ako.code[ako.pc] == ']':
                        lalim += 1

ang code = "-[->+++++++++>+++>->>>>->>->>>>->>->>>>->+++->+>++>>+>->++>>+>->++>>+>->++>++++++++++>[>>>]<[>------->-------->->-->>]>>-[<-]<++[[[>>]+++<[>]++[<]<-]>-<<++]>+>[+>]<<[++++[>++++<-]<<]<<<[[>->>>++++++++++<<<<+]<[>->>>>+<<<<<+]<]>>[>]>[<+>>+>>+<<<-][-[>>+<<-]>>]<[<+>-]<[>++<-]<[<<]<<[>->>[>]+[<]<<-]->>>[>]<+[<-<]>+[.>+++++++++[-[>>+<<-]>.>]++++++++++.[-]>]+[<<]<[,->>>---[<<<--->>>-],<-<<[<++>>>++<<---[<++[>-----<-]>>+>-<<[--<----[>+<[-]]]]]>[<+>>++++++++++<-][-[>>+<<-]>>]++++[>--------<-]>[-[[<<]<[-]<[-]>>>>[-]]]+[>>]+[[-]<<]<<<<[[>>[<<->>-]>>+<<<<[+<<]>>>>]>>[<<]<<<<[+>>]>>>>[<<]>>[<<<<<<->>->>>>-]<<<]-[+<-]-<]]>>-----[>+++<-]>-.----------.++++++.>---.[<<+>-->----]<-.+++++.----.<++."
ang interpreter = BrainfuckInterpreter.bago(code, input(""))
interpreter.takbo()
