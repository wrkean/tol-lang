klase Tao:
    paraan bago(pangalan, edad):
        ang tao = Tao()
        tao.pangalan = pangalan
        tao.edad = edad

        ibalik tao

    paraan say(ako):
        print "Hello, ako si " ++ ako.pangalan

    paraan isa_pa():
        print "isa pa!"

ang tao = Tao.bago("Keanne", 20)
print tao.pangalan
tao.say()
